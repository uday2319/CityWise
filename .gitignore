.env
.env.local
.env.*.local
*.env

# ── Node.js / Frontend ────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
.vite/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build output
*.tsbuildinfo

# ── Data and ML model files ───────────────────────────────────────────────
# Raw datasets (large, not needed at runtime)
data/raw/

# Full processed CSVs (commit sample versions only)
data/processed/*.csv

# Binary model artifacts (regenerated by running ML scripts)
data/models/*.npy
data/models/*.faiss
data/models/*.pkl

# HuggingFace / SBERT model cache (auto-downloaded on first run)
.cache/
models/
sentence_transformers/

# ── IDE and editor ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

